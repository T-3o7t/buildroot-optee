# U-Boot measured boot on the QEMU virt TPM (tcg,tpm-tis-mmio on the
# platform bus @ 0x4000000, "-device tpm-tis-device,tpmdev=tpm0").
# Ported from keystone overlays/keystone/board/qemu/generic/uboot-tpm.config.
#
# bootm_measure() extends: PCR8 <- kernel, PCR9 <- initrd, PCR1 <- bootargs,
# PCR0 <- DTB + CRTM version, PCR0-7 <- separators. It silently measures
# NOTHING unless the TPM DT node carries an event-log buffer
# (tpm_event_log_addr/size). Unlike keystone, the DTB here is our own
# (qemu_rv64_virt_domain.dts, patched in patches/linux/), so the buffer is
# declared in the DTS and no CONFIG_PREBOOT fdt surgery is needed.
CONFIG_TPM=y
CONFIG_TPM2_MMIO=y
CONFIG_CMD_TPM=y
CONFIG_MEASURED_BOOT=y
# With patches/uboot/0001-cmd-booti-*.patch, bootm_measure() hashes the
# relocated Image over the header's image_size (text+data+BSS), i.e. ~450KiB
# past the end of the file.  Those bytes are copied from wherever extlinux
# loaded the file, and the stock kernel_addr_r (0x84000000) is SPL's BSS/heap
# (CONFIG_SPL_BSS_START_ADDR), so the tail would be SPL heap leftovers.  Load
# the kernel into untouched RAM instead: the tail is then all zeros and PCR8
# == extend(sha256(Image zero-padded to image_size)) (see readme.txt).
CONFIG_USE_PREBOOT=y
CONFIG_PREBOOT="setenv kernel_addr_r 0x86000000"
