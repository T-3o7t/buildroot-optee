# TPM 2.0 (QEMU tpm-tis-device on the virt platform bus) + IMA measurement,
# mirroring keystone's overlays/keystone/configs/linux64-defconfig.
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_HW_RANDOM_TPM=y
CONFIG_TCG_TPM2_HMAC=n
CONFIG_SECURITYFS=y
CONFIG_INTEGRITY=y
CONFIG_IMA=y
# IMA_DEFAULT_HASH_SHA256 needs CRYPTO_SHA256 built in (arch defconfig has it =m)
CONFIG_CRYPTO_SHA256=y
CONFIG_IMA_DEFAULT_HASH_SHA256=y
CONFIG_IMA_WRITE_POLICY=y
CONFIG_IMA_DISABLE_HTABLE=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
